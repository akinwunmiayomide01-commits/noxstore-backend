generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  reference String   @unique
  email     String
  game      String
  amount    Int
  status    String   @default("success")
  createdAt DateTime @default(now())
}